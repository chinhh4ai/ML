# Choose ONE provider: gemini | openai | litellm
AI_PROVIDER=gemini

# Gemini (vision-capable model)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI (vision-capable model)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# LiteLLM proxy: alias must exist in your proxy and support image input.
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4.1-mini
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# Optional shared overrides. Leave blank to use selected provider settings above.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# CPU-only model. yolo11n-seg: masks + boxes. yolox-nano: boxes only.
DETECTION_MODEL=yolo11n-seg
DETECTION_CONFIDENCE=0.25
CPU_THREADS=2
# Higher FPS helps tracking but consumes more CPU. Not a real-time guarantee.
VIDEO_SAMPLE_FPS=2
VIDEO_CHUNK_SECONDS=30
VIDEO_MAX_DURATION_SECONDS=1800
VIDEO_MAX_UPLOAD_MB=256
# Limit AI cost: remaining segments still have local detection.
AI_MAX_SEGMENTS=60
