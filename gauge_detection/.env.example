# ========================================================
# Industrial Gauge Detection & Reading System Configuration
# ========================================================

# AI Provider to use: 'gemini', 'openai', 'litellm', or 'mock'
AI_PROVIDER=gemini

# ----------------- Google Gemini Vision -----------------
# Obtain your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ----------------- OpenAI Vision ------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----------------- LiteLLM Proxy / Local vLLM ----------
LITELLM_API_KEY=sk-1AdUrg6SJB5the4AmtWniQ
# Tested working models: Gemma-26B-A4B-It-L40.1.127 or Llama-3.1-Nemotron-Nano-VL-8B-V1-FP4-QAD-A30.0.121
LITELLM_MODEL=Gemma-26B-A4B-It-L40.1.127

# ----------------- Server Settings ----------------------
HOST=0.0.0.0
PORT=5050
DEBUG=True
CONFIDENCE_THRESHOLD=0.5
